{
  "name": "@stellarclear/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for StellarClear settlement evidence and reconciliation protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.0",
    "@stellarclear/proof": "0.1.0",
    "@stellarclear/schemas": "0.1.0",
    "buffer": "^6.0.3",
    "settlement-registry": "0.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
